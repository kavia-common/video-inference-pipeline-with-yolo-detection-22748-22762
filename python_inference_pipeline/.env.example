# Paths
WORK_DIR=./work
OUTPUT_DIR=./work/outputs

# Input (choose one)
# INPUT_VIDEO=/absolute/or/relative/path/to/video.mp4
S3_VIDEO_URI=s3://your-bucket/path/to/video.mp4

# Model weights (local path or S3)
MODEL_SOURCE=s3://your-bucket/path/to/yolo.pt
MODEL_LOCAL_PATH=./work/model.pt

# Thresholds
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Runtime
# DEVICE=cpu
# MAX_FRAMES=500
FRAME_STRIDE=1

# Optional output upload (not used by default pipeline, reserved for future)
# S3_OUTPUT_PREFIX=s3://your-bucket/path/to/output-prefix/
