# Local-first configuration for running in VS Code (Windows-friendly).
#
# How to use:
# 1) Copy this file to `.env` in this folder.
# 2) Set INPUT_VIDEO and MODEL_SOURCE to paths on your machine.
# 3) Optionally set OUTPUT_DIR to where you want artifacts written.
#
# Notes:
# - Windows paths are supported, including:
#     C:\data\video.mp4
#     C:/data/video.mp4
# - Quote paths if they contain spaces.
# - S3 is OPTIONAL. If you provide S3_VIDEO_URI or MODEL_SOURCE starting with s3://,
#   the pipeline will use AWS credentials from your environment.

# Base working directory (scratch space; downloads/copies may go here)
WORK_DIR=./work

# Where outputs are written (annotated video, failed frames/labels, CSV reports)
OUTPUT_DIR=./outputs

# Local video path (preferred for local dev)
INPUT_VIDEO=C:/path/to/your/video.mp4

# Local model weights path (preferred for local dev)
MODEL_SOURCE=C:/path/to/your/model.pt

# Optional: where to copy the model locally (defaults under WORK_DIR)
# MODEL_LOCAL_PATH=./work/model.pt

# Optional S3 inputs (only needed if you want S3)
# S3_VIDEO_URI=s3://my-bucket/path/to/video.mp4
# S3_OUTPUT_PREFIX=s3://my-bucket/path/to/output-prefix/

# Inference thresholds
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Runtime options
# DEVICE=cpu
# MAX_FRAMES=200
FRAME_STRIDE=1
